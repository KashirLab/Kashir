ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

minimum_ios_version = min_ios_version_supported
platform :ios, minimum_ios_version
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Kashir' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Run Codegen during development for the example app.
  pre_install do |installer|
    unless system('yarn', 'codegen', chdir: File.expand_path('../..', __dir__))
      abort 'Kashir native code generation failed'
    end
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # React Native's hook skips resource bundles, which can declare older targets.
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_configurations.each do |configuration|
        settings = configuration.build_settings
        current = settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.correct?(current) && Gem::Version.new(current) < Gem::Version.new(minimum_ios_version)
          settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
        end
      end
    end
  end
end
